# Copy to .env.local and fill in keys.

# ElevenLabs – required for voiceover generation
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Default voice (optional). Any ElevenLabs voice_id.
ELEVENLABS_DEFAULT_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Default model (optional). eleven_multilingual_v2 is a solid documentary default.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Pexels – free key at https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay – free key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Openverse, Wikimedia Commons, Internet Archive: no key required.

# Render output directory (absolute or relative to project)
RENDER_OUT_DIR=out
